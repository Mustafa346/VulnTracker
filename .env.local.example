# ═════════════════════════════════════════════════════════════════
#  ValnTracker — Environment Variables Template
#  ─────────────────────────────────────────────────────────────
#  HOW TO USE:
#  1. Copy this file:  cp .env.local.example .env.local
#  2. Fill in your values below
#  3. NEVER commit .env.local to GitHub — it is in .gitignore
# ═════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────
#  DATABASE — MongoDB Atlas
#  ─────────────────────────────────────────────────────────
#  STATUS:  ✅ REQUIRED — app will not start without this
#  HOW TO GET:
#    1. Go to https://www.mongodb.com/atlas and create a free account
#    2. Create a free M0 cluster
#    3. Create a database user (username + password)
#    4. Go to Connect → Drivers → copy the URI
#    5. Replace <username>, <password> with your credentials
#    6. Add /valntracker before the ? to set the database name
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/valntracker?retryWrites=true&w=majority


# ─────────────────────────────────────────────────────────────
#  NEXTAUTH — Session Management
#  ─────────────────────────────────────────────────────────
#  STATUS:  ✅ REQUIRED — authentication will not work without this
#
#  NEXTAUTH_URL:
#    - Development: http://localhost:3000
#    - Production:  https://your-deployed-domain.vercel.app
#
#  NEXTAUTH_SECRET:
#    - Any random string of 32+ characters
#    - Used to sign and encrypt JWT session tokens
#    - Generate one: https://generate-secret.vercel.app/32
#    - Or run in terminal: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-this-with-a-random-32-character-secret-string


# ─────────────────────────────────────────────────────────────
#  VIRUSTOTAL API — URL Scanner (70+ antivirus engines)
#  ─────────────────────────────────────────────────────────
#  STATUS:  ⚡ RECOMMENDED — mock fallback activates if missing
#  USED IN: /api/scan-url
#  HOW TO GET:
#    1. Go to https://www.virustotal.com/gui/join-us
#    2. Create a free account
#    3. Click your profile icon → API Key
#    4. Copy the 64-character key
#  FREE TIER: 4 requests/minute, 500/day
# ─────────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here


# ─────────────────────────────────────────────────────────────
#  GOOGLE SAFE BROWSING API — Malware & Phishing Blacklist
#  ─────────────────────────────────────────────────────────
#  STATUS:  ⚡ RECOMMENDED — mock fallback activates if missing
#  USED IN: /api/scan-url and /api/check-website
#  HOW TO GET:
#    1. Go to https://console.cloud.google.com
#    2. Create a new project (name it anything)
#    3. APIs & Services → Enable APIs → search "Safe Browsing API" → Enable
#    4. APIs & Services → Credentials → Create Credentials → API Key
#    5. Copy the key
#  FREE TIER: 10,000 requests/day
# ─────────────────────────────────────────────────────────────
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here


# ─────────────────────────────────────────────────────────────
#  URLSCAN.IO API — Page Behaviour Analysis & Screenshot
#  ─────────────────────────────────────────────────────────
#  STATUS:  💡 OPTIONAL — mock fallback activates if missing
#  USED IN: /api/scan-url
#  HOW TO GET:
#    1. Go to https://urlscan.io/user/signup
#    2. Create a free account
#    3. Go to your profile → API Key
#    4. Copy the key
#  FREE TIER: 1,000 private scans/day
# ─────────────────────────────────────────────────────────────
URLSCAN_API_KEY=your_urlscan_api_key_here


# ─────────────────────────────────────────────────────────────
#  SHODAN API — Open Ports & Known Vulnerabilities (CVEs)
#  ─────────────────────────────────────────────────────────
#  STATUS:  💡 OPTIONAL — mock fallback activates if missing
#  USED IN: /api/check-website
#  HOW TO GET:
#    1. Go to https://account.shodan.io/register
#    2. Create a free account
#    3. Go to https://account.shodan.io → copy your API key
#  FREE TIER: Limited to 1 request/second, no scan credits
# ─────────────────────────────────────────────────────────────
SHODAN_API_KEY=your_shodan_api_key_here


# ═════════════════════════════════════════════════════════════════
#  SUMMARY
# ═════════════════════════════════════════════════════════════════
#
#  ✅ REQUIRED (app won't start):
#     MONGODB_URI, NEXTAUTH_URL, NEXTAUTH_SECRET
#
#  ⚡ RECOMMENDED (mock fallback if missing):
#     VIRUSTOTAL_API_KEY, GOOGLE_SAFE_BROWSING_KEY
#
#  💡 OPTIONAL (mock fallback if missing):
#     URLSCAN_API_KEY, SHODAN_API_KEY
#
# ═════════════════════════════════════════════════════════════════
